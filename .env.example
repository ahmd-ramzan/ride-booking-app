APP_NAME=RideLahore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL is required (partial unique indexes, CHECK constraints, row locks).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=ride_booking
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=database

# API tokens
SANCTUM_TOKEN_EXPIRATION_MINUTES=10080

# Ride domain tuning (see config/rides.php)
RIDES_MAX_PICKUP_DISTANCE_KM=8
RIDES_AVERAGE_SPEED_KMH=22
RIDES_ROAD_DISTANCE_FACTOR=1.3

MAIL_MAILER=log
